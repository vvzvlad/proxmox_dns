# Proxmox API access: a JSON list with one entry per INDEPENDENT PVE host, all merged
# into one zone. A CLUSTER is a single entry — one endpoint answers for every node in
# it. API tokens only, one per host; see the "Proxmox setup" section of README.md,
# including the ACL a token needs before it can see anything.
#
# No defaults in code, and at least one entry is required: the app fails at startup
# with a message naming the variable rather than serving an empty zone. On a name
# collision between hosts the running VM wins, ties going to the host listed first.
#
# IT HAS TO STAY ON ONE LINE. .env has no line continuation, so a value wrapped across
# two lines is cut at the newline and fails at startup as "not valid JSON" — and so
# does `PROXMOX_HOSTS=` with nothing after it. Remove the variable rather than emptying
# it if you want the startup message to say "missing" instead.
#
# One line, one entry per host:
PROXMOX_HOSTS=[{"host": "pve1.example", "user": "proxmoxdns@pve", "token_name": "dns", "token_value": "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"}, {"host": "pve2.example", "user": "proxmoxdns@pve", "token_name": "dns", "token_value": "yyyyyyyy-yyyy-yyyy-yyyy-yyyyyyyyyyyy"}]

# Logging level: DEBUG / INFO / WARNING / ERROR / CRITICAL
LOG_LEVEL=INFO

# Resolve subdomains of a VM domain to the parent's IP (true/false)
SUBDOMAINS=false

# Domain suffix appended to the VM name prefix to form the FQDN
DOMAIN_SUFFIX=lc
