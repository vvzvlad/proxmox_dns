# Proxmox API access (credentials + host of your own PVE — no defaults in code,
# the app fails at startup if any of these is missing).
PROXMOX_HOST=your_proxmox_host
PROXMOX_USER=proxmoxdns@pve
PROXMOX_PASSWORD=your_password_here

# Logging level: DEBUG / INFO / WARNING / ERROR / CRITICAL
LOG_LEVEL=INFO

# Resolve subdomains of a VM domain to the parent's IP (true/false)
SUBDOMAINS=false

# Domain suffix appended to the VM name prefix to form the FQDN
DOMAIN_SUFFIX=lc
